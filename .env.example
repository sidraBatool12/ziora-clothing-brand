MONGODB_URI=mongodb://127.0.0.1:27017/ziora

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google Cloud Console OAuth 2.0 credentials
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image storage. Required in production; without it, development falls back to
# writing uploads into public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=10
ADMIN_EMAIL=admin@ziora.pk
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=ZIORA Admin
